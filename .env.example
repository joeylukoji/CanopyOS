APP_ENV=development
DATA_DIR=data
# Optional cache location; omit to use the Hugging Face user cache.
# HF_HOME=data/model-cache

# TypeSafe's real Jev API. Leave blank for an explicitly labelled rules fallback.
JEV_API_KEY=
JEV_MODEL=jev-latest

# Ollama base URL, not /api/chat. Leave blank for a labelled template explanation.
# Run `ollama pull gemma3:1b` separately before setting this.
GEMMA_ENDPOINT=
GEMMA_API_KEY=
GEMMA_MODEL=gemma3:1b
